{
  "opencollection": "1.0.0",
  "info": {
    "name": "AlphaSense Agent Authentication User API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "User",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Execute An AlphaSense Utility GraphQL Operation",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.alpha-sense.com/gql",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Same /gql endpoint as the Agent API; pick the Utility surface via the GraphQL operation name (`search`, `companies`, `brokers`, `watchlists`, `trends`, `user`, `downloads`)."
        }
      ]
    }
  ],
  "bundled": true
}