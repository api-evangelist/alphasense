                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "grant_type",
                  "value": "<string>",
                  "description": "(Required) OAuth 2.0 grant type. Must be 'password'."
                },
                {
                  "disabled": false,
                  "key": "username",
                  "value": "<email>",
                  "description": "(Required) AlphaSense user email."
                },
                {
                  "disabled": false,
                  "key": "password",
                  "value": "<password>",
                  "description": "(Required) AlphaSense user password."
                },
                {
                  "disabled": false,
                  "key": "client_id",
                  "value": "<string>",
                  "description": "(Required) OAuth client identifier issued by AlphaSense."
                },
                {
                  "disabled": false,
                  "key": "client_secret",
                  "value": "<password>",
                  "description": "(Required) OAuth client secret issued by AlphaSense."
                }
              ]
            }
          },
